			)
		)
		(uuid "ceb713d6-e006-45fa-9642-ae7ff70bc512")
	)
	(text "By default, the bidirectional level shifter is on, \nhence the pull-up resistor on the OE pin. If OE is \noff, 1.8v and 3.3 are isolated, no I2C communication\noccurs outside 1.8v.\n\n"
		(exclude_from_sim no)
		(at 32.512 370.84 0)
		(effects
