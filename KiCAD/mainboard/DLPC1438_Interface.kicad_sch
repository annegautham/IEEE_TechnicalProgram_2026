	(text "Inverting Buffer with Open-Drain output buffer\n"
		(exclude_from_sim no)
		(at 36.322 240.03 0)
		(effects
			(font
				(size 0.762 0.762)
			)
		)
		(uuid "06657912-78bb-4607-8b96-d15979100191")
	)
	(text "By default, the bidirectional level shifter is on, \nhence the pull-up resistor on the OE pin. If OE is \noff, 1.8v and 3.3 are isolated, no I2C communication\noccurs outside 1.8v.\n\n"
		(exclude_from_sim no)
		(at 32.512 374.65 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "06960d93-2e86-489a-b97a-50969fa0ea47")
	)
	(text "INTZ is active low, peripheral sets INTZ to zero to involve DLPC, \npush-pull outputs no need for pull-ups"
		(exclude_from_sim no)
		(at 184.658 356.87 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "08ab8500-ec67-4fcc-bbaa-b7b2e75eb10d")
	)
	(text "Chip's PLL needs its own bypass caps, VDD, VSS, and ferrite beads\non each line for signal integrity reasons. \n "
		(exclude_from_sim no)
		(at 200.914 172.974 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "31d8685f-b3f0-46eb-baf0-4fa6e5d2c288")
	)
	(text "external pull up for tri-stated pin"
